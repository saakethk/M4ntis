# Assistant (POST /llm). Set GEMINI_API_KEY and/or META_API_KEY; the editor's model
# picker enables each provider whose key is present. AI_PROVIDER/AI_MODEL pick the default.
# Current models: gemini-3.8-flash, gemini-3.7-flash, gemini-3.5-flash-lite,
# gemini-3.1-pro-preview, muse-spark-1.3, muse-spark-1.2.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Meta Model API key (Muse Spark). Also powers AI summaries on discussion posts.
META_API_KEY=
# Optional: another Muse model for post summaries (default muse-spark-1.3).
POST_SUMMARY_MODEL=
CURSOR_API_KEY=
TIGER_DB_PGPASSWORD=
TIGER_DB_PGUSER=
TIGER_DB_PGDATABASE=
TIGER_DB_PGHOST=
TIGER_DB_PGPORT=
TIGER_DB_PGSSLMODE=
ALPACA_API_KEY=
ALPACA_API_SECRET=
BACKEND_PORT=
FRONTEND_PORT=
VITE_API_URL=
# Backtests run only on the TradeCPU FPGA. FPGA_SERIAL_PORT defaults to COM4 (Windows).
# On macOS/Linux set it to the board's port (e.g. /dev/cu.usbserial-XXXX; ls /dev/tty.usb*).
# FPGA_BAUD defaults to 115200, BACKTEST_TICKS to 500, BACKTEST_MAX_TICKS to 20000.
FPGA_SERIAL_PORT=
FPGA_BAUD=
BACKTEST_TICKS=
BACKTEST_MAX_TICKS=
